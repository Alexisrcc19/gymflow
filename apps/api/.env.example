NODE_ENV=development
PORT=3333
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://gymflow:gymflow_dev@localhost:5433/gymflow?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=30
REFRESH_COOKIE_NAME=gymflow_refresh
SEED_ADMIN_EMAIL=admin@gymflow.local
SEED_ADMIN_PASSWORD=replace-with-a-demo-password-of-at-least-12-characters
